{
  "name": "@mhxy13867806343/dsh-update-vd",
  "version": "1.1.0",
  "description": "DSH Desktop 桌面增强：① 更新中心（侧栏版本号 + 进度条弹窗 + 一键装好，支持断点续传）② 设置里的「技能」页（列表/搜索/新增/编辑/删除/导入）③ 设置里的「MCP」页（服务器增删改查 + 即时挂载）。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "SUBMIT.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "meta": {
    "title": "更新中心",
    "description": "更新中心（进度条 + 一键装好 + 断点续传）+ 设置里的技能管理与 MCP 管理（列表/搜索/新增/编辑/删除/导入，删除二次确认）。"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhxy13867806343/dsh-update-vd.git"
  },
  "homepage": "https://github.com/mhxy13867806343/dsh-update-vd",
  "bugs": {
    "url": "https://github.com/mhxy13867806343/dsh-update-vd/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "desktop",
    "update",
    "updater",
    "macos"
  ],
  "license": "MIT",
  "os": [
    "darwin"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
